{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyforge.dev/schemas/screenplay.schema.json",
  "title": "StoryForge screenplay (one part of an arc)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "cast",
    "location",
    "time_of_day",
    "beats"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "maxLength": 60
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "logline": {
      "type": "string",
      "maxLength": 300
    },
    "part": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      }
    },
    "location": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "time_of_day": {
      "enum": [
        "morning",
        "day",
        "afternoon",
        "sunset",
        "evening",
        "night"
      ]
    },
    "music_mood": {
      "enum": [
        "playful",
        "mysterious",
        "tense",
        "sad",
        "triumphant",
        "calm",
        "comedic",
        "spooky"
      ]
    },
    "hook": {
      "type": "string",
      "maxLength": 200,
      "description": "What grabs the viewer in the first 1-2 s"
    },
    "mini_payoff": {
      "type": "string",
      "maxLength": 240
    },
    "cliffhanger": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker",
          "line",
          "emotion",
          "intensity",
          "action",
          "performance_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$",
            "description": "Beat id, e.g. b01"
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "description": "Cast id of the speaker, null for a silent action beat"
          },
          "addressee": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "description": "Who the line is said to (drives eyelines)"
          },
          "line": {
            "type": "string",
            "maxLength": 240,
            "description": "Spoken dialogue; empty for action beats"
          },
          "emotion": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "angry",
              "shocked",
              "smug",
              "scared",
              "confused",
              "embarrassed",
              "excited",
              "tired",
              "determined",
              "relieved",
              "suspicious"
            ]
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "action": {
            "type": "string",
            "maxLength": 320,
            "description": "What we see happen"
          },
          "performance_note": {
            "type": "string",
            "maxLength": 220,
            "description": "Acting/voice direction"
          },
          "camera_hint": {
            "anyOf": [
              {
                "enum": [
                  "close_up",
                  "crane_up",
                  "dolly",
                  "establishing_wide",
                  "extreme_close_up",
                  "handheld",
                  "high_angle",
                  "insert",
                  "low_angle",
                  "medium",
                  "medium_close",
                  "medium_wide",
                  "orbit",
                  "over_the_shoulder",
                  "pan",
                  "pov",
                  "pull_out",
                  "push_in",
                  "reaction",
                  "snap_zoom",
                  "static",
                  "truck",
                  "two_shot",
                  "whip_pan",
                  "wide"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "beat_type": {
            "enum": [
              "hook",
              "recap",
              "setup",
              "escalation",
              "turn",
              "joke",
              "reveal",
              "payoff",
              "cliffhanger",
              "resolution"
            ]
          },
          "gesture": {
            "anyOf": [
              {
                "enum": [
                  "talk",
                  "wave",
                  "point",
                  "shrug",
                  "nod",
                  "head_shake",
                  "hands_on_hips",
                  "cross_arms",
                  "facepalm",
                  "cheer",
                  "jump",
                  "gasp",
                  "laugh",
                  "cry",
                  "think",
                  "look_around",
                  "thumbs_up",
                  "scratch_head",
                  "lean_in",
                  "recoil",
                  "clap",
                  "shiver",
                  "bow",
                  "pick_up",
                  "give",
                  "peek"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "motion": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "enter",
                      "exit",
                      "walk_to",
                      "run_to",
                      "turn_to",
                      "sit",
                      "stand",
                      "tiptoe_to"
                    ]
                  },
                  "character": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-z][a-z0-9_]{0,39}$"
                  },
                  "to": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 40
                  },
                  "side": {
                    "enum": [
                      "left",
                      "right",
                      "back",
                      "front",
                      null
                    ]
                  }
                }
              }
            ]
          },
          "props": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "character",
                "prop",
                "action"
              ],
              "properties": {
                "character": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "prop": {
                  "enum": [
                    "phone",
                    "backpack",
                    "sandwich",
                    "book",
                    "map",
                    "flashlight",
                    "key",
                    "cup",
                    "ball",
                    "notebook",
                    "magnifying_glass",
                    "apple",
                    "umbrella",
                    "camera",
                    "gear",
                    "letter",
                    "cookie",
                    "gadget"
                  ]
                },
                "action": {
                  "enum": [
                    "hold",
                    "pick_up",
                    "put_down",
                    "use",
                    "give",
                    "show",
                    "drop"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                }
              }
            }
          },
          "fx": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "character",
                "type"
              ],
              "properties": {
                "character": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "type": {
                  "enum": [
                    "sweat_drop",
                    "tears",
                    "anger_mark",
                    "blush",
                    "sparkles",
                    "question_mark",
                    "shock_lines",
                    "exclamation_mark",
                    "lightbulb"
                  ]
                }
              }
            }
          },
          "sfx": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pace": {
                "enum": [
                  "slow",
                  "normal",
                  "fast"
                ]
              },
              "volume": {
                "enum": [
                  "whisper",
                  "soft",
                  "normal",
                  "loud",
                  "shout"
                ]
              }
            }
          }
        }
      }
    }
  }
}

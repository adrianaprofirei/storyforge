# ---------------------------------------------------------------------------
# StoryForge configuration. Copy to `.env` and fill in what you have.
# Every variable is optional: with nothing set, StoryForge runs in demo mode
# (bundled sample bible/arc/screenplays, Piper/espeak voices if available,
# otherwise silent dialogue with captions). `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Data -------------------------------------------------------------------
# Where projects, caches, renders and outputs live (default: ./data).
STORYFORGE_DATA_DIR=./data
# Force demo mode even when API keys are present (1/0).
STORYFORGE_DEMO=0

# --- LLM (story: arc planner, screenplay, script review, continuity) --------
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY,
# else the offline demo provider.  Values: auto | anthropic | openai | demo
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Claude model id. Default: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Effort for Claude requests: low | medium | high | xhigh | max (default high)
ANTHROPIC_EFFORT=high
# Server-side refusal fallbacks (Claude API beta), ON by default: if Claude declines a request,
# the API re-runs it on the model Anthropic recommends for that refusal category.
#   default                 -> fallbacks="default" (beta server-side-fallback-2026-07-01)
#   claude-opus-4-8,...     -> your own fallback model list (beta server-side-fallback-2026-06-01)
#   off                     -> disabled
ANTHROPIC_FALLBACKS=default
OPENAI_API_KEY=
# OpenAI chat model used for story generation (e.g. gpt-5.5, gpt-5.6-sol).
OPENAI_MODEL=gpt-5.5
# Optional: custom OpenAI-compatible base URL (Azure/proxy, or a local server such as
# Ollama http://localhost:11434/v1 or LM Studio http://localhost:1234/v1 - set any non-empty
# OPENAI_API_KEY for those). Leave empty for api.openai.com
OPENAI_BASE_URL=
# Optional reasoning effort for OpenAI reasoning models (e.g. low | medium | high). Empty = model default.
OPENAI_REASONING_EFFORT=
# Maximum attempts when the LLM returns JSON that fails schema validation.
LLM_MAX_ATTEMPTS=4

# --- TTS (voices) -------------------------------------------------------------
# auto = ElevenLabs -> OpenAI TTS -> Piper -> espeak-ng -> silent (first available)
# Values: auto | elevenlabs | openai | piper | espeak | silent
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 returns character timestamps; eleven_v3 adds audio tags
# ([whispers], [shouts], ...) for voice direction (alignment falls back to Whisper).
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS model with per-line "instructions" voice direction.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Piper (offline). Either the `piper` executable or the `piper-tts` Python package.
PIPER_PATH=
# Folder with Piper voices (*.onnx + *.onnx.json). Default: ./tools/piper_voices
PIPER_VOICES_DIR=
# espeak-ng executable (very robotic, last-resort offline fallback).
ESPEAK_PATH=

# --- Word timing / alignment --------------------------------------------------
# auto = provider timings (ElevenLabs) -> OpenAI Whisper (if key) -> local
# faster-whisper (if installed) -> energy/syllable heuristic.
# Values: auto | openai | local | heuristic
ALIGNMENT_MODE=auto
WHISPER_LOCAL_MODEL=base.en

# --- External tools -----------------------------------------------------------
# Blender 4.2 LTS or newer (5.2 LTS recommended). Windows example:
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
BLENDER_PATH=
# Development alternative: a Python interpreter that has the `bpy` module
# installed (pip install bpy). Used only when BLENDER_PATH is empty.
BLENDER_PYTHON=
# ffmpeg/ffprobe (needs libass for burned-in captions). Default: from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Rhubarb Lip Sync executable (https://github.com/DanielSWolf/rhubarb-lip-sync)
# Default: tools/rhubarb/rhubarb(.exe) or PATH. Without it a built-in estimator is used.
RHUBARB_PATH=

# --- Rendering ------------------------------------------------------------------
# auto picks OPTIX > CUDA > HIP > ONEAPI > METAL, else CPU.
RENDER_DEVICE=auto
# Parallel Blender render processes (shots rendered concurrently). 1 is best on a single GPU.
RENDER_WORKERS=1
# Default render preset for `storyforge run`: draft | final | final_4k | proxy
RENDER_PRESET=draft
# Frame rate for new series: 30 or 60
RENDER_FPS=30
# Blender process timeout per shot (seconds).
BLENDER_TIMEOUT=7200

# --- Web server -------------------------------------------------------------------
STORYFORGE_HOST=127.0.0.1
STORYFORGE_PORT=8000
# Render jobs that may run at the same time (each uses RENDER_WORKERS Blender processes). The
# story lane (LLM work) and the preview lane (character previews) always run alongside.
STORYFORGE_WORKERS=1
